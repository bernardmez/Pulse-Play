  "description": "Backend API for Pulse Play music streaming platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint src server.js app.js",
    "format": "prettier --write \"**/*.{js,json}\" --ignore-path .gitignore",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand"
