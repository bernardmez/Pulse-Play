# ============================================================================
# Pulse Play — Environment Variable Reference
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# ---- Database (MariaDB / MySQL) -------------------------------------------
DB_HOST=database                        # Docker service name or host
DB_PORT=3306
DB_NAME=pulse_play
DB_USER=pulseplay_user                  # Non-root DB user
DB_PASSWORD=CHANGE_ME_32_RANDOM_CHARS   # 32+ char random string

# Root password used by the database container on first init
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ---- Backend ---------------------------------------------------------------
PORT=5000
NODE_ENV=production                     # production | development

# 64-byte hex JWT secret: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=CHANGE_ME_64_BYTE_HEX_SECRET

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# ---- Frontend (build-time Vite vars must start with VITE_) ----------------
VITE_API_URL=http://localhost:5000

# Optional: Sentry DSN for frontend error tracking
# VITE_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# ---- AI Chatbot (Pulse Assistant) -----------------------------------------
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
